{
  "expo": {
    "name": "HSU24 Mitarbeiter",
    "slug": "hsu24-mitarbeiter",
    "scheme": "hsumitarbeiter",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "de.hsu24.mitarbeiter"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F5F6F8"
      },
      "package": "de.hsu24.mitarbeiter",
      "edgeToEdgeEnabled": true
    },
    "plugins": ["expo-router", "expo-secure-store", "expo-font", "expo-asset"],
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "experiments": {
      "typedRoutes": false
    }
  }
}
